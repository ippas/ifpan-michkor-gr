  geom_bar(width = 1, stat = "identity", color = "white") +
  coord_polar("y") +
  theme_void() +
  labs(fill = "Labels", title = "Pie Chart with ggplot2")


install.packages("plotly")
require(plotly)

# Example data
values <- c(10, 15, 20, 30)
labels <- c("A", "B", "C", "D")

# Create the pie chart
plot_ly(labels = ~labels, values = ~values, type = 'pie', textinfo = 'label+percent',
        insidetextorientation = 'radial') %>%
  layout(title = 'Pie Chart with Plotly')


install.packages("highcharter")
require(highcharter)


# Example data
values <- c(10, 15, 20, 30)
names(values) <- c("A", "B", "C", "D")

# Create the pie chart
hchart(values, type = "pie", name = "Example Pie Chart",
       dataLabels = list(enabled = TRUE, format = '{point.name}: {point.percentage:.1f}%'))


