papers_gene_list %>% 
  unname() %>%  unlist %>% table %>% as.data.frame() %>% 
  set_colnames(c("gene_name", "n")) %>% 
  filter(n > 12) -> tmp


# Przykładowa lista wektorów genów
lista_genow <- list(
  c("genA", "genB", "genC"),
  c("genA", "genD"),
  c("genB", "genE"),
  c("genA", "genB", "genE")
)

# Funkcja do obliczania P(A)
p_a <- function(gen, lista) {
  sum(sapply(lista, function(x) gen %in% x)) / length(lista)
}

# Funkcja do obliczania P(A ∩ B)
p_a_and_b <- function(genA, genB, lista) {
  sum(sapply(lista, function(x) all(c(genA, genB) %in% x))) / length(lista)
}

# Funkcja do obliczania P(B|A)
p_b_given_a <- function(genA, genB, lista) {
  p_a_and_b(genA, genB, lista) / p_a(genA, lista)
}

