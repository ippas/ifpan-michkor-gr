test_function <- function(data, ..., arrange_by = "log2ratio") {
  print(dim(data))
  
  args <- enquos(...)
  print(args)  # Sprawdź, jakie argumenty są przekazywane
  
  data %>%
    filter(!!!args) -> data
  
  print(dim(data))
  print("check")
  data %>% 
    drop_na(!!!sym(arrange_by)) %>%
    filter(get(arrange_by) != "NA") -> data
  
  
  print(dim(data))
}

