gene_list_log2ratio_top_50 %>% 
  select(-data) %>% 
  unnest(top_50_genes) %>% 
  ungroup %>%
  group_by(regulation, simple_tissue) %>% 
  nest() %>% 
  mutate(n_list = map(data, ~ .x %>% .$label_regulation %>% unique %>% length)) %>% 
  mutate(n_genes = map(data, ~ .x %>% .$hgnc_symbol %>% unique %>% length)) %>% 
  unnest(c(n_list, n_genes))



# Przygotowanie danych (Twoje przetworzone dane)
plot_data <- gene_list_log2ratio_top_50 %>% 
  select(-data) %>% 
  unnest(top_50_genes) %>% 
  ungroup() %>%
  group_by(simple_tissue, regulation) %>% 
  nest() %>% 
  mutate(n_list = map(data, ~ .x %>% .$label_regulation %>% unique %>% length)) %>% 
  mutate(n_genes_tissue = map(data, ~ .x %>% .$hgnc_symbol %>% unique %>% length)) %>% 
  unnest(c(n_list, n_genes_tissue))

# Tworzenie wykresu
ggplot(plot_data, aes(x = simple_tissue, y = n_genes_tissue, fill = regulation)) +
  geom_bar(stat = "identity", position = "dodge") +
  labs(x = "Simple Tissue", y = "Number of Genes", title = "Number of Genes per Tissue by Regulation") +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
  scale_fill_manual(values = c("down" = "blue", "up" = "red"))



plot_data %>% unnest(data) %>% 
  group_by(regulation, simple_tissue) %>% 
  nest() %>% 
  mutate(top_50_tissue = map(data, ~ .x %>% arrange(desc(abs(log2ratio))) %>% head(50))) 

plot_data %>% 
  unnest(data) %>% 
  group_by(regulation, simple_tissue, hgnc_symbol) %>% 
  nest() %>% 
  mutate(sum_rs = map(data, ~ .x$rank_score %>% sum)) %>% 
  unnest(sum_rs) %>% 
  group_by(regulation, simple_tissue) %>% 
  nest() %>% 
  mutate(top_50_rs = map(data, ~ .x %>% arrange(desc(sum_rs)) %>% head(50))) %>% 
  select(-data) %>% 
  unnest(top_50_rs) %>% 
  unnest(data) %>%
  ungroup() %>% 
  group_by(simple_tissue) %>% 
  nest() %>% 
  mutate(n_records = map(data, ~nrow(.x))) %>% 
  unnest(n_records) %>% 
  arrange(desc(n_records)) %>% 
  mutate(simple_tissue = factor(simple_tissue, levels = unique(simple_tissue))) %>% 
  unnest(data) %>% 
  ggplot(aes(simple_tissue, y = log2ratio, color = regulation)) +
  geom_boxplot() +
  geom_jitter() +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))+
  scale_color_manual(values = c("down" = "blue", "up" = "red"))



