library(biomaRt)


# "uswest" albo "asia".
# Ustawienie dostępu do baz Ensembl dla człowieka i myszy
human <- useEnsembl(biomart = "ensembl", dataset = "hsapiens_gene_ensembl", mirror = "uswest")
mouse <- useEnsembl(biomart = "ensembl", dataset = "mmusculus_gene_ensembl", mirror = "uswest")

# Ustawienie dłuższego timeoutu
options(timeout = 300)

# Pobranie ortologów
human_mouse_orthologs <- getLDS(
  attributes = c("hgnc_symbol", "ensembl_gene_id", "gene_biotype"),
  mart = human,
  attributesL = c("mgi_symbol", "ensembl_gene_id", "gene_biotype"),
  martL = mouse
)# 
