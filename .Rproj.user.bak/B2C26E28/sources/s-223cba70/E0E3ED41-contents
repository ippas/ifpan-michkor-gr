# histogram
intesection_results_all_gr_signatures %>% 
  filter(range_plus_minus != "100") %>% 
  select(rsID, pvalue, range_plus_minus, signature_derivation) %>% 
  unique() %>% 
  ggplot(aes(x = -log10(pvalue))) +
  geom_histogram(binwidth = 0.1, fill = "gray80") +
  geom_vline(xintercept = c(5, 8), linetype = "dashed", color = "red", size = 0.7) +
  labs(title = "Histogram -log10(p-value)",
       x = expression(-log[10](p)),
       y = "Liczba obserwacji (log10)") +
  scale_y_log10() +
  theme_minimal() +
  facet_grid(signature_derivation ~ range_plus_minus)


intesection_results_all_gr_signatures %>% 
  filter(range_plus_minus != "100") %>% 
  group_by(signature_derivation, range_plus_minus) %>% 
  nest() %>% 
  mutate(n_rsid_pvalue_10e8 = map(data, ~ .x %>% 
                             filter(pvalue < 0.00000001) %>% 
                             .$rsID %>% unique %>% length)) %>% 
  mutate(n_genes_pvalue_10e8 = map(data, ~ .x %>% 
                                    filter(pvalue < 0.00000001) %>% 
                                    .$gene_symbol %>% unique %>% length)) %>%
  mutate(n_rsid_pvalue_10e5_10e8 = map(data, ~ .x %>% 
                                    filter(pvalue > 0.00000001 & pvalue < 0.00001) %>% 
                                    .$rsID %>% unique %>% length)) %>% 
  mutate(n_genes_pvalue_10e5_10e8 = map(data, ~ .x %>% 
                                     filter(pvalue > 0.00000001 & pvalue < 0.00001) %>% 
                                     .$gene_symbol %>% unique %>% length)) %>%
  mutate(n_rsid_pvalue_higher_10e5 = map(data, ~ .x %>% 
                                         filter(pvalue > 0.00001) %>% 
                                         .$rsID %>% unique %>% length)) %>% 
  mutate(n_genes_pvalue_higher_10e5 = map(data, ~ .x %>% 
                                          filter(pvalue > 0.00001) %>% 
                                          .$gene_symbol %>% unique %>% length)) %>%
  unnest(n_rsid_pvalue_10e8, n_genes_pvalue_10e8,
         n_rsid_pvalue_10e5_10e8, n_genes_pvalue_10e5_10e8,
         n_rsid_pvalue_higher_10e5, n_genes_pvalue_higher_10e5)


intesection_results_all_gr_signatures %>% 
  filter(pvalue < 0.00000001) %>% 
  filter(range_plus_minus == "100000") %>% 
  filter(signature_derivation == "tissue_cell") %>% arrange(pvalue) %>% 
  head(150)  %>% tail(25)

