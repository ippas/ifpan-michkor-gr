         tissue == "blood-noMacrophages",
         rank_criterion == "log2ratio",
         size_list == 50) %>% 
  .$hgnc_symbol %>% 
  perform_enrichment_analysis(gene_list = ., databases = "GO_Biological_Process_2023", fdr_threshold = 0.05, overlap_threshold) -> blood_enrichr_results$blood_noMacrophages


blood_enrichr_results$blood %>% 
  plotEnrich(., showTerms = 40, numChar = 50, y = "Count", orderBy = "P.value", title = "blood")

blood_enrichr_results$blood_macrophages %>% 
  plotEnrich(., showTerms = 40, numChar = 50, y = "Count", orderBy = "P.value", title = "blood macrophages")

