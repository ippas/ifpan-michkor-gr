blood_enrichr_results <- list()


overlap_threshold <- 3

tissue_master_df %>%
  filter(regulation == "up",
         tissue == "blood",
         rank_criterion == "log2ratio",
         size_list == 50) %>%
  .$hgnc_symbol %>% 
  perform_enrichment_analysis(gene_list = ., databases = "GO_Biological_Process_2023", fdr_threshold = 0.05, overlap_threshold) -> blood_enrichr_results$blood


detailed_tissue_master_df %>% 
  filter(regulation == "up",
         tissue == "blood-macrophages",
         rank_criterion == "log2ratio",
         size_list == 50) %>% 
  .$hgnc_symbol %>% 
  perform_enrichment_analysis(gene_list = ., databases = "GO_Biological_Process_2023", fdr_threshold = 0.05, overlap_threshold) -> blood_enrichr_results$blood_macrophages



detailed_tissue_master_df %>% 
