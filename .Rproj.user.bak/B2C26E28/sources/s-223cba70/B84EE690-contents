list1 <- c("GEN1", "GEN2", "GEN3", "GEN4", "GEN5")
list2 <- c("GEN1", "GEN2", "GEN3", "GEN6", "GEN7")


# Obliczenie części wspólnej (intersection)
intersection <- length(intersect(list1, list2))

# Obliczenie unii (union)
union <- length(union(list1, list2))

# Obliczenie indeksu Jaccarda
jaccard_index <- intersection / union

# Wydruk wyniku
print(jaccard_index)


# Przykładowe dane
list1 <- c("GEN1", "GEN2", "GEN3", "GEN4", "GEN5")
list2 <- c("GEN1", "GEN2", "GEN3", "GEN6", "GEN7", "GEN8")

# Obliczenie przecięcia zbiorów
intersection <- intersect(list1, list2)
intersection_size <- length(intersection)

# Obliczenie mniejszego zbioru
min_size <- min(length(list1), length(list2))

# Obliczenie miary Simpsona
simpson_index <- intersection_size / min_size

# Wydruk wyniku
print(simpson_index)


