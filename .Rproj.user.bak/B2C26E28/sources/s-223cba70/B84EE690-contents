# Definicja dwóch sekwencji DNA
seq1 <- "GATTACA"
seq2 <- "GATCTCA"

# Funkcja do obliczania odległości Hamminga
hamming_distance <- function(s1, s2) {
  if (nchar(s1) != nchar(s2)) {
    stop("Sekwencje muszą mieć tę samą długość")
  }
  
  # Obliczanie różnic między sekwencjami
  sum(s1 != s2)
}

# Obliczenie i wydrukowanie odległości Hamminga
distance <- hamming_distance(seq1, seq2)
print(distance)
