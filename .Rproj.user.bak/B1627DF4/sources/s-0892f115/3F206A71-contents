library(pheatmap)
library(pheatmap)
library(grid)

# Create a sample matrix with random data
set.seed(123)
sample_matrix <- matrix(runif(100), nrow = 10)

# Generate a heatmap using `pheatmap`
heatmap_object <- pheatmap(sample_matrix)

# Determine which cells to highlight with a green frame
# Selecting some random cells to highlight
highlight_cells <- data.frame(
  rows = c(2, 5), # Row indices of cells to highlight
  cols = c(3, 8)  # Column indices of cells to highlight
)

# Map the highlight cells to the order
highlight_cells$rows <- heatmap_object$tree_row$order[highlight_cells$rows]
highlight_cells$cols <- heatmap_object$tree_col$order[highlight_cells$cols]

# Calculate the coordinates of the cells to highlight
cell_width <- 1 / ncol(sample_matrix)
cell_height <- 1 / nrow(sample_matrix)

# Add the rectangles
for(i in 1:nrow(highlight_cells)) {
  row <- highlight_cells$rows[i]
  col <- highlight_cells$cols[i]
  
  grid.rect(
    x = (col - 1 + 0.5) * cell_width,
    y = (nrow(sample_matrix) - row + 0.5) * cell_height,
    width = cell_width,
    height = cell_height,
    just = "centre",
    gp = gpar(col = "green", lwd = 2, fill = NA)
  )
}

