# Sample data
set.seed(123)
mat <- matrix(rnorm(100), 10)

# Define the scale range
scale_range <- c(0, 8)

# Define breaks and colors for the heatmap scale
breaks <- seq(scale_range[1], scale_range[2], length.out = 101)
colors <- colorRampPalette(c("blue", "white", "red"))(length(breaks) - 1)

# Create the heatmap
Heatmap(mat, 
        name = "scaled_heatmap")
