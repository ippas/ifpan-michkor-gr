library(pheatmap)
library(grid)

# Step 1: Create a sample matrix with random data
set.seed(123)  # for reproducibility
sample_matrix <- matrix(runif(20), nrow = 4)

# Step 2: Generate a heatmap using `pheatmap`
heatmap_object <- pheatmap(sample_matrix, cluster_cols = FALSE, cluster_rows = FALSE)

# Step 3: Calculate positions for the rectangles based on the clustering
# Since we're not clustering, we'll use the original indices
# We want to highlight cells in the first row of the first and third columns
highlight_cells <- data.frame(
  rows = c(1, 1),  # Row indices of cells to highlight
  cols = c(1, 3)   # Column indices of cells to highlight
)

# Step 4: Navigate to the correct viewport
# We assume the viewport is named "panel", which is commonly the case but may vary
current_vp <- viewport(name = "panel", width = unit(1, "npc"), height = unit(1, "npc"))
pushViewport(current_vp)

# Step 5: Overlay the rectangles on the specified cells
for (i in 1:nrow(highlight_cells)) {
  # Calculate the center of the cell
  cell_center_x <- unit((highlight_cells$cols[i] - 0.5) / ncol(sample_matrix), "npc")
  cell_center_y <- unit((nrow(sample_matrix) - highlight_cells$rows[i] + 0.5) / nrow(sample_matrix), "npc")
  
  # Draw the rectangle
  grid.rect(
    x = cell_center_x,
    y = cell_center_y,
    width = unit(1 / ncol(sample_matrix), "npc"),
    height = unit(1 / nrow(sample_matrix), "npc"),
    just = "center",
    gp = gpar(col = "green", lwd = 2, fill = NA)
  )
}

# Step 6: Exit the viewport
popViewport()
