# Define your custom legends
lgd1 <- Legend(title = "My First Legend", 
               at = c("A", "B", "C"), 
               labels = c("Group A", "Group B", "Group C"))  # Use 'colors' instead of 'col'

lgd2 <- Legend(title = "My Second Legend", 
               at = c("X", "Y", "Z"), 
               labels = c("Type X", "Type Y", "Type Z"), 
               colors = c("orange", "purple", "brown"))  # Use 'colors' instead of 'col'

# Now draw the heatmap with both legends
draw(ht, heatmap_legend_side = "right", 
     annotation_legend_side = "right", 
     annotation_legend_list = list(lgd1, lgd2))