  .$overlap_genes %>%
  strsplit(., split = ",") %>% 
  unlist %>% 
  unique() %>%  unique() %>% length
  intersect(c("LRIG1", "CPS1", "SLCO1B1", "CYP3A43", "SLC16A9"))
  walk(., ~cat(.x, "\n"))  %>% length()

  filter(metabolism %in% c("X-11564", "X-11261", "X-21470", "X-21467")) %>% .$overlap_genes


