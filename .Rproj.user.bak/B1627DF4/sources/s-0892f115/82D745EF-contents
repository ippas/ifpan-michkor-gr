compare_gene_vectors <- function(list_vectors) {
  # Initialize an empty list to store the results
  intersect_results <- list()
  
  # Compare each vector to every other vector
  for (i in 1:(length(list_vectors) - 1)) {
    for (j in (i + 1):length(list_vectors)) {
      # Get the names of the vectors being compared
      name1 <- names(list_vectors)[i]
      name2 <- names(list_vectors)[j]
      
      # Find the intersection of the two vectors
      common_genes <- intersect(list_vectors[[i]], list_vectors[[j]])
      
      # Store the result in the list with a descriptive name
      intersect_results[[paste(name1, "vs", name2)]] <- common_genes
    }
  }
  
  return(intersect_results)
}


intersect_genes <- compare_gene_vectors(gr_gene_list)

extract_comparisons_with <- function(intersect_results, target_name) {
  # Extract elements with names containing the target_name
  relevant_results <- intersect_results[grep(target_name, names(intersect_results))]
  return(relevant_results)
}

extract_comparisons_with <- function(intersect_results, target_names) {
  if (length(target_names) != 2) {
    stop("Please provide exactly two target names.")
  }
  
  # Extract elements with names containing both target names
  relevant_results <- intersect_results[
    grepl(target_names[1], names(intersect_results)) & 
      grepl(target_names[2], names(intersect_results))
  ]
  
  return(relevant_results)
}

