get_title <- function(pmid) {
  if (pmid == "" || is.na(pmid)) {
    return(NA)
  }
  tryCatch({
    paper <- entrez_fetch(db="pubmed", id=pmid, rettype="xml", parsed=FALSE)
    parsed_paper <- xmlParse(paper)
    title <- xpathSApply(parsed_paper, "//ArticleTitle", xmlValue)
    if (length(title) > 0) title[1] else NA
  }, error = function(e) NA)
}


