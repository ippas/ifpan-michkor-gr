gr_gene_filter_biomart %>% 
  head

gr_gene_filter_biomart %>% 
  select(c(Gene_name, label))

split(gr_gene_filter_biomart$Gene_name, gr_gene_filter_biomart$label) -> gr_gene_list

datasets <- gr_gene_list


# Set total number of genes to be the ones in dataset1
total_genes = biomart_genes_in_go %>% .$gene_name %>% tolower() %>% unique()

# Calculate overlapping genes for each pair of datasets
overlap_matrix = matrix(nrow = length(datasets), ncol = length(datasets),
                        dimnames = list(names(datasets), names(datasets)))

for (i in 1:length(datasets)) {
  for (j in 1:length(datasets)) {
    overlap_matrix[i,j] = length(intersect(datasets[[i]], datasets[[j]]))
  }
}


# Perform chi-square tests and calculate p-values for each pair of datasets
p_value_matrix = matrix(nrow = length(datasets), ncol = length(datasets),
                        dimnames = list(names(datasets), names(datasets)))

# Prepare chi-square results matrix
chi2_value_matrix = matrix(nrow = length(datasets), ncol = length(datasets),
                           dimnames = list(names(datasets), names(datasets)))

# Perform chi-square tests and calculate p-values and chi-squared statistics for each pair of datasets
for (i in 1:length(datasets)) {
  for (j in 1:length(datasets)) {
    print(names(datasets[[i]]))
    intersect_genes = unique(c(datasets[[i]], datasets[[j]]))  
    
    total_genes[!total_genes %in% intersect_genes] -> external_genes
    
    print(length(external_genes))
    
    matrix_chi2 = matrix(c(overlap_matrix[i,j], length(datasets[[i]]) - overlap_matrix[i,j], 
                           length(datasets[[j]]) - overlap_matrix[i,j],  length(external_genes)),
                         nrow = 2)
    print(matrix_chi2)
    test_result = chisq.test(matrix_chi2)
    p_value_matrix[i,j] = test_result$p.value
    chi2_value_matrix[i,j] = test_result$statistic # Store the chi-square statistic
    cat("Performed chi-square test on", names(datasets)[i], "and", names(datasets)[j], "\n")
  }
}

p_value_matrix <- ifelse(p_value_matrix == 0, NA, p_value_matrix)

# Print the chi-square results matrix
print(chi2_value_matrix)

# Use pheatmap to create the heatmap
pheatmap(p_value_matrix, cluster_rows = T, cluster_cols = T, display_numbers = T, number_format = "%.3e")

